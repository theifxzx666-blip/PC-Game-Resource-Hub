{
  "name": "game-resource-hub-demo",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "PC 游戏资源服务工具客户端",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build": "npm run build:preload && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "verify:deps": "node scripts/verify-deps.cjs",
    "package:win": "npm run build && electron-builder --win portable",
    "verify:data": "node scripts/verify-data.cjs",
    "verify:search": "node --import ./scripts/electron-loader-register.mjs scripts/verify-search.cjs",
    "verify": "npm run verify:deps && npm run verify:data && npm run verify:search"
  },
  "dependencies": {
    "@element-plus/icons-vue": "*",
    "element-plus": "*",
    "pinia": "*",
    "vue": "*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "*",
    "electron": "44.4.5",
    "electron-builder": "*",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "*",
    "vue-tsc": "*"
  },
  "build": {
    "appId": "com.demo.pcgamehub",
    "productName": "游戏资源服务工具演示",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources/tools",
        "to": "tools"
      },
      {
        "from": "resources/data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    }
  }
}
